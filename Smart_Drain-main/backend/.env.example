PORT=3001
NODE_ENV=development

# MongoDB connection string
# SECURITY NOTICE: Do NOT use 0.0.0.0/0 in production MongoDB Atlas Network Access.
# Restrict access to trusted municipal VPC/static IP addresses only.
MONGODB_URI=mongodb://localhost:27017/smartdrain

# Allowed device IDs (comma-separated; newly registered DB devices are also recognized dynamically)
ALLOWED_DEVICES=DRAIN_001,DRAIN_002,DRAIN_003

# Municipal Authority Authentication
AUTH_SECRET=smartdrain_secure_authority_secret_key_2026
AUTHORITY_ADMIN_PASSWORD=Authority@2026

# Isolated Demo Mode: Set to false in production to disable simulation endpoints
DEMO_MODE=true

# Optional experimental ML service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1500
